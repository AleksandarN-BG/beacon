{
  "auth": {
    "rolesSource": "/api/get-roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/api/get-roles",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/incidents",
      "methods": ["GET", "POST"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/incidents",
      "methods": ["PUT"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/incidents",
      "methods": ["DELETE"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/schedule",
      "methods": ["GET"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/schedule",
      "methods": ["POST", "DELETE"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/alert-sms",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/alert-call",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/users",
      "methods": ["GET"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/users",
      "methods": ["PUT"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/voice-twiml",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/call-events",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/debug",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/logs",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/logout",
      "rewrite": "/.auth/logout"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "*.css", "*.js", "*.svg", "*.ico"]
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/index.html",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/index.html"
    }
  }
}

